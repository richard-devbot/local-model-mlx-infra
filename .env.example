# Server configuration
MODEL_HOST=127.0.0.1
MODEL_PORT=8080

# Storage paths
MODELS_CACHE_DIR=~/.cache/huggingface/hub

# Text model (1M Context)
# MLX 4-bit (~2.4 GB VRAM / disk):
LOCAL_TEXT_MODEL=hermitdave/Spark-X2.5-4B-MLX-4bit
# Native BF16 (~8.2 GB VRAM / disk):
LOCAL_TEXT_MODEL_BF16=XHToken/Spark-X2.5-4B
PREFER_BF16_TEXT=false

# Image model
LOCAL_IMAGE_MODEL=mlx-community/Qwen-Image-2.1-MLX-4bit

# Audio model
LOCAL_AUDIO_MODEL=stepfun-ai/Step-Audio-TTS-3B

# Memory & VRAM protection
MAX_WIRED_MEMORY_GB=11.8
MODEL_IDLE_TTL_SECONDS=300
ENABLE_SIMULATION_FALLBACK=true
